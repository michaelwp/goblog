# Copy to .env; `make run` and `make up` load it automatically. .env is gitignored.
# The admin password is not configured here: it is stored (hashed) in MongoDB
# and created on first visit to /admin/setup.

# MongoDB connection. The default points at the MongoDB container from
# `make mongo`; use mongodb://localhost:27017 for a local mongod, or a
# mongodb+srv:// URI for a hosted cluster (percent-encode special characters in
# the password, e.g. @ as %40). `make run` and `make up` both connect here;
# `make up` starts its MongoDB container when this is localhost:27018 or unset.
MONGODB_URI=mongodb://localhost:27018
MONGODB_DB=blog

# Optional overrides (defaults shown).
# PORT=8080
# Supported languages, default first. Keep in sync with frontend/src/lib/i18n.ts.
# LANGUAGES=en,id
# Public address for share links and link previews (Open Graph). Unset uses
# the address each request came in on.
# SITE_URL=https://goblog.dev

# AI tag and category suggestions in the article editor (optional; off when
# unset). Paste a key from any provider; it's recognised by its prefix:
# OpenAI (sk-...), Anthropic (sk-ant-...), Google Gemini (AIza...),
# Groq (gsk_...), OpenRouter (sk-or-...), xAI (xai-...).
# AI_API_KEY=
# For another OpenAI-compatible provider (Mistral, DeepSeek, a local Ollama,
# ...), also set its base URL. AI_MODEL overrides the provider's default model.
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_MODEL=
# Cover images are generated with OpenAI (gpt-image-1), Gemini (Imagen) and xAI
# keys; other providers pick the best image already in the article instead.
# If the default image model isn't available to your key, the server finds
# one the provider lists. AI_IMAGE_MODEL pins a model instead (and enables
# images for AI_BASE_URL).
# AI_IMAGE_MODEL=
